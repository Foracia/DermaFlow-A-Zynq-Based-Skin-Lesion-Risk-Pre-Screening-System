[Unit]
Description=Skin image risk screening terminal
After=local-fs.target systemd-udev-trigger.service derm-ui.service
Conflicts=derm-ui.service
StartLimitIntervalSec=300
StartLimitBurst=1

[Service]
Type=simple
User=root
WorkingDirectory=/home/xilinx/dermaflow/board/system_ui
Environment=XILINX_XRT=/usr
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
Environment=PATH=/usr/local/share/pynq-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/share/pynq-venv/bin/python3 /home/xilinx/dermaflow/board/system_ui/board_terminal_service.py --root /home/xilinx/dermaflow/board/hardware --load --run
Restart=no
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=infinity
SendSIGKILL=no
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=80
UMask=0022

[Install]
WantedBy=multi-user.target
